CQA_API_URL=https://example.invalid/cqa/conversations
CQA_DB_PATH=cqa.db
CQA_BATCH_CONCURRENCY=8
LLM_PROVIDER=openai
LLM_MODEL=gpt-6.1-sol
LLM_LABEL=GPT-6.1 Sol
LLM_EFFORT=medium
LLM_PROMPT_VERSION=v2
LLM_FALLBACK_MODEL=
OPENAI_API_KEY=
OPENAI_MAX_OUTPUT_TOKENS=32000
OPENAI_CALL_CEILING_S=180
OPENAI_MAX_ATTEMPTS=5
OPENAI_MAX_INFLIGHT=12
OPENAI_GEN_MODEL=gpt-6.1-sol
# Rollback to Claude Opus 5.5: set these four, keep LLM_API_KEY, restart the server
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=medium
# LLM_PROMPT_VERSION=v2
LLM_API_KEY=
LLM_BASE_URL=https://api.anthropic.com
LLM_STRUCTURED_OUTPUTS=true
LLM_MAX_TOKENS=8192
# Opus prices, used only when LLM_PROVIDER is anthropic or bedrock; the openai provider takes its prices from the model profile
# LLM_PRICE_INPUT=4.0
# LLM_PRICE_OUTPUT=20.0
# LLM_PRICE_CACHE_READ=0.2
# LLM_PRICE_CACHE_WRITE=5.0
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
OPENROUTER_API_KEY=
